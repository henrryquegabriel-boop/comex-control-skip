# Valores publicáveis do Supabase. Nunca coloque service_role no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=CHAVE_PUBLICAVEL

# true mantém o shell visual aberto e sem dados para revisão no Skip.
VITE_BLUEPRINT_MODE=true

# Estilo MapLibre. Pode ser substituído por um provedor contratado.
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
